{
  "name": "simulation",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint src vite.config.ts worker.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:fix": "eslint src vite.config.ts worker.js --fix",
    "deploy": "pnpm build && wrangler deploy"
  },
  "dependencies": {
    "gl-matrix": "4.0.0-beta.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "webgpu-utils": "^1.10.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/eslint-plugin": "^8.23.0",
    "@typescript-eslint/parser": "^8.23.0",
    "@webgpu/types": "^0.1.53",
    "eslint": "^9",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.3",
    "prettier": "^3.5.0",
    "typescript": "^5",
    "vite": "^8.3.8",
    "wrangler": "^4.165.0"
  },
  "type": "module"
}
